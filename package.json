{
  "name": "golden-rentals-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/src/index.js --production",
    "typecheck": "tsc --noEmit && ngc -p apps/web/tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:validate": "node --import tsx scripts/validate-demo.ts",
    "adk:validate": "node --import tsx scripts/validate-adk.ts",
    "gemini:check": "node --import tsx scripts/check-gemini.ts",
    "real:validate": "node --import tsx scripts/validate-real.ts",
    "package": "node --import tsx scripts/package.ts",
    "workshop:check": "node --import tsx scripts/workshop.ts",
    "workshop:run": "node --import tsx scripts/workshop.ts",
    "workshop:web": "node --import tsx scripts/workshop-web.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@google/adk": "2.4.0",
    "@google/genai": "2.32.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "10.0.1",
    "@google/adk-devtools": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
