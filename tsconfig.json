{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests",
    "*.ts",
    "workshop"
  ],
  "exclude": [
    "apps/web",
    "node_modules",
    "dist"
  ]
}
