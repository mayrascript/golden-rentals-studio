# TODO 1.1 · Duplica esta plantilla como .env en tu propia carpeta.
# Qué hace: configura el servidor local; sus valores no se envían al navegador.

# TODO 1.3 · Mantén simulated durante los ejercicios; real activa Gemini en la web.
GENERATION_MODE=simulated

# TODO 1.2 · Pega tu clave personal solo en .env cuando decidas probar Gemini.
# Sin clave puedes usar la demo y todas las comprobaciones offline.
GOOGLE_GENAI_API_KEY=

# Identificadores de modelos usados por el taller, ya configurados.
# El modelo de texto ejecuta los agentes; la herramienta llama al modelo de imágenes.
TEXT_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image

# Puerto local. Cambia este valor si otra aplicación está usando el mismo puerto.
PORT=4317
